{
  "manifest_version": 3,
  "name": "Visible Tab Snapshot Copier",
  "version": "1.0.0",
  "description": "現在表示中のタブを撮影し、画像としてクリップボードへコピーします。",
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "offscreen",
    "downloads",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "capture-snapshot": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "表示中のタブを撮影してコピー"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png"
    },
    "default_title": "画面を撮影してコピー",
    "default_popup": "popup.html"
  }
}
